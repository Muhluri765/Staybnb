@model Staybnb.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <i class="bi bi-houses-fill text-danger" style="font-size: 2.5rem;"></i>
                    <h3 class="fw-bold mt-2">Welcome to Staybnb</h3>
                    <p class="text-muted small">Please sign in to your account</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">Email address</label>
                        <input asp-for="Email" class="form-control rounded-3 py-2" placeholder="name@example.com" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-secondary">Password</label>
                        <input asp-for="Password" class="form-control rounded-3 py-2" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="RememberMe" />
                        <label class="form-check-label small text-secondary" asp-for="RememberMe">
                            Remember my login
                        </label>
                    </div>

                    <button type="submit" class="btn btn-staybnb w-100 py-2 fs-6 mb-3">
                        Continue
                    </button>

                    <div class="text-center small text-muted">
                        Don't have an account?
                        <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]" class="text-dark fw-bold text-decoration-none">Sign up</a>
                    </div>
                </form>

                <!-- Course Grader Quick Fill / Demo Accounts Helper -->
                <div class="mt-4 pt-3 border-top">
                    <div class="small fw-bold text-muted text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                        Quick Demo Credentials (Assignment Testing):
                    </div>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-danger">SuperAdmin</span>
                                <span class="font-monospace ms-1">admin@staybnb.com</span>
                            </div>
                            <span class="text-muted font-monospace">Admin@123</span>
                        </div>
                        <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary">Host</span>
                                <span class="font-monospace ms-1">host@staybnb.com</span>
                            </div>
                            <span class="text-muted font-monospace">Host@123</span>
                        </div>
                        <div class="p-2 bg-light rounded border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-success">Guest</span>
                                <span class="font-monospace ms-1">guest@staybnb.com</span>
                            </div>
                            <span class="text-muted font-monospace">Guest@123</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
