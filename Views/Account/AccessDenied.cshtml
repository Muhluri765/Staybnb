@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
        <h2 class="fw-bold mt-3">Access Denied</h2>
        <p class="text-muted max-w-md mx-auto" style="max-width: 500px;">
            You do not have the required role or authorization permissions to access this page.
            Staybnb enforces strict mutual exclusivity between Guest, Host, and Administrator roles.
        </p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-staybnb rounded-pill px-4">
                Return to Stays
            </a>
        </div>
    </div>
</div>
