@model IEnumerable<Staybnb.Models.WishlistItem>

@{
    ViewData["Title"] = "Your Wishlist";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Your Wishlists</h2>
            <p class="text-muted small">All your saved favorite stays in one place.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark rounded-pill px-3">
            <i class="bi bi-compass me-1"></i> Explore More
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-heart text-muted fs-1"></i>
            <h4 class="fw-bold mt-3">Your wishlist is empty</h4>
            <p class="text-muted">As you search, tap the heart icon on any listing to save your favorite spots.</p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-staybnb rounded-pill px-4">Start Exploring</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                var p = item.Property;
                if (p != null)
                {
                    var img = p.PropertyImages.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/600";
                    var avgRating = p.Reviews.Any() ? p.Reviews.Average(r => r.Rating) : 0.0;

                    <div class="col">
                        <div class="card card-staybnb h-100 position-relative">
                            <div class="property-img-container">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id">
                                    <img src="@img" alt="@p.Title" />
                                </a>

                                <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="d-inline">
                                    <input type="hidden" name="propertyId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="wishlist-heart-btn active" title="Remove from Wishlist">
                                        <i class="bi bi-heart-fill text-danger"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="card-body p-3 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="card-title fw-bold text-truncate mb-0" style="max-width: 80%;">
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id" class="text-dark text-decoration-none">
                                            @p.Title
                                        </a>
                                    </h6>
                                    <div class="d-flex align-items-center small">
                                        <i class="bi bi-star-fill text-warning me-1"></i>
                                        <span class="fw-semibold">@(avgRating > 0 ? avgRating.ToString("0.0") : "New")</span>
                                    </div>
                                </div>

                                <p class="card-text text-muted small text-truncate mb-2">
                                    <i class="bi bi-geo-alt me-1"></i> @p.Address
                                </p>

                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold fs-6 text-dark">R @p.PricePerNight.ToString("N0")</span>
                                        <span class="text-muted small"> / night</span>
                                    </div>
                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                        View
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
