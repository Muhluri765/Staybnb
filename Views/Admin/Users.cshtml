@model IEnumerable<Staybnb.ViewModels.Admin.UserManagementViewModel>

@{
    ViewData["Title"] = "User Roles Management";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger px-3 py-2 rounded-pill small mb-1">SuperAdmin Privilege</span>
            <h2 class="fw-bold mb-0">Platform User & Role Governance</h2>
            <p class="text-muted small">Only SuperAdmin can promote standard users to the Administrator role.</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    <div class="alert alert-info border-0 rounded-4 p-3 shadow-sm mb-4 small">
        <i class="bi bi-shield-lock-fill text-primary me-2"></i>
        <strong>Rubric Rule:</strong> "Only SuperAdmin can promote a Guest/Host to the 'Admin' role." Role promotions are tracked in the ActivityLog.
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Assigned Roles</th>
                        <th>User Type</th>
                        <th class="text-end">Role Management</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold small" style="width: 36px; height: 36px;">
                                        @(user.FullName.FirstOrDefault())
                                    </div>
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                </div>
                            </td>
                            <td class="small text-muted font-monospace">@user.Email</td>
                            <td>
                                @foreach (var r in user.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    var trimmed = r.Trim();
                                    var badgeClass = trimmed == "SuperAdmin" ? "bg-danger" : (trimmed == "Admin" ? "bg-dark" : (trimmed == "Host" ? "bg-primary" : "bg-success"));
                                    <span class="badge @badgeClass rounded-pill px-2 py-1 me-1 small">@trimmed</span>
                                }
                            </td>
                            <td>
                                @if (user.IsSuperAdmin)
                                {
                                    <span class="text-danger fw-bold small"><i class="bi bi-star-fill me-1"></i> Root SuperAdmin</span>
                                }
                                else if (user.IsAdmin)
                                {
                                    <span class="text-dark fw-semibold small"><i class="bi bi-shield-shaded me-1"></i> Staff Admin</span>
                                }
                                else if (user.IsHost)
                                {
                                    <span class="text-primary fw-semibold small"><i class="bi bi-house me-1"></i> Property Host</span>
                                }
                                else
                                {
                                    <span class="text-success fw-semibold small"><i class="bi bi-person me-1"></i> Verified Guest</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (user.IsSuperAdmin)
                                {
                                    <span class="badge bg-light text-muted border">Protected SuperAdmin</span>
                                }
                                else if (user.IsAdmin)
                                {
                                    <form asp-action="DemoteFromAdmin" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Demote this admin user?');">
                                            <i class="bi bi-arrow-down me-1"></i> Demote from Admin
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="PromoteToAdmin" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="return confirm('Promote this user to Platform Administrator?');">
                                            <i class="bi bi-arrow-up me-1"></i> Promote to Admin
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
