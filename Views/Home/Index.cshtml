@model IEnumerable<Staybnb.Models.HostProperty>

@{
    ViewData["Title"] = "Find your next stay";
    var wishlistIds = (List<int>)(ViewBag.WishlistPropertyIds ?? new List<int>());
    var amenities = (List<Amenity>)(ViewBag.Amenities ?? new List<Amenity>());
}

<div class="container py-4">
    <!-- Airbnb Filter / Search Bar -->
    <div class="card border-0 shadow-sm rounded-pill p-2 mb-4 bg-white">
        <form method="get" asp-action="Index" class="row g-2 align-items-center px-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchCity" value="@ViewBag.SearchCity" class="form-control border-0 shadow-none" placeholder="Where to? (e.g. Camps Bay, Sandton, Durban)" />
                </div>
            </div>
            <div class="col-md-3 border-start">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0"><i class="bi bi-tag text-muted"></i></span>
                    <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control border-0 shadow-none" placeholder="Max price per night (R)" min="100" step="50" />
                </div>
            </div>
            <div class="col-md-2 border-start">
                <select name="amenityId" class="form-select border-0 shadow-none">
                    <option value="">Any Amenity</option>
                    @foreach (var am in amenities)
                    {
                        if (ViewBag.SelectedAmenityId != null && (int)ViewBag.SelectedAmenityId == am.Id)
                        {
                            <option value="@am.Id" selected>@am.Name</option>
                        }
                        else
                        {
                            <option value="@am.Id">@am.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-staybnb rounded-pill px-4 w-100">
                    <i class="bi bi-search me-1"></i> Search
                </button>
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.SearchCity) || ViewBag.MaxPrice != null || ViewBag.SelectedAmenityId != null)
    {
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div class="text-muted small">
                Showing search results for: <strong>@(string.IsNullOrEmpty(ViewBag.SearchCity) ? "All locations" : ViewBag.SearchCity)</strong>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-danger">Clear filters</a>
        </div>
    }

    <!-- Property Card Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-house-x text-muted" style="font-size: 3.5rem;"></i>
            <h4 class="mt-3 fw-bold">No active properties found</h4>
            <p class="text-muted">Try adjusting your search criteria or clearing filters to discover other available stays.</p>
            <a asp-action="Index" class="btn btn-outline-staybnb mt-2">Browse All Stays</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var property in Model)
            {
                var firstImage = property.PropertyImages.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=800&q=80";
                var isWishlisted = wishlistIds.Contains(property.Id);
                var avgRating = property.Reviews.Any() ? property.Reviews.Average(r => r.Rating) : 0.0;

                <div class="col">
                    <div class="card card-staybnb h-100 position-relative">
                        <!-- Property Image -->
                        <div class="property-img-container">
                            <a asp-action="Details" asp-route-id="@property.Id">
                                <img src="@firstImage" alt="@property.Title" />
                            </a>

                            <!-- Wishlist Toggle Form -->
                            <form asp-controller="Wishlist" asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="propertyId" value="@property.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <button type="submit" class="wishlist-heart-btn @(isWishlisted ? "active" : "")" title="@(isWishlisted ? "Remove from Wishlist" : "Save to Wishlist")">
                                    <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart")"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 class="card-title fw-bold text-truncate mb-0" style="max-width: 80%;">
                                    <a asp-action="Details" asp-route-id="@property.Id" class="text-dark text-decoration-none">
                                        @property.Title
                                    </a>
                                </h6>
                                <div class="d-flex align-items-center small">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <span class="fw-semibold">@(avgRating > 0 ? avgRating.ToString("0.0") : "New")</span>
                                </div>
                            </div>

                            <p class="card-text text-muted small text-truncate mb-2">
                                <i class="bi bi-geo-alt me-1"></i> @property.Address
                            </p>

                            <!-- Amenities preview tags -->
                            @if (property.Amenities.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var am in property.Amenities.Take(2))
                                    {
                                        <span class="badge bg-light text-secondary border small font-monospace">
                                            <i class="bi @am.IconClass me-1"></i>@am.Name
                                        </span>
                                    }
                                </div>
                            }

                            <!-- Price -->
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-bold fs-6 text-dark">R @property.PricePerNight.ToString("N0")</span>
                                    <span class="text-muted small"> / night</span>
                                </div>
                                <a asp-action="Details" asp-route-id="@property.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
