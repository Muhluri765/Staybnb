@model Staybnb.ViewModels.Host.HostDashboardViewModel

@{
    ViewData["Title"] = "Host Dashboard";
}

<div class="container py-4">
    <!-- Dashboard Top Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div>
            <span class="badge bg-primary px-3 py-2 rounded-pill small mb-1">Host Operations</span>
            <h2 class="fw-bold mb-0">Host Command Center</h2>
            <p class="text-muted small">Manage your properties, review reservation requests, and verify guest check-in IDs.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Properties" class="btn btn-outline-dark rounded-pill px-3">
                <i class="bi bi-buildings me-1"></i> My Properties
            </a>
            <a asp-action="Bookings" class="btn btn-staybnb rounded-pill px-3">
                <i class="bi bi-calendar2-check me-1"></i> View All Bookings
            </a>
        </div>
    </div>

    <!-- Stat KPI Cards -->
    <div class="row row-cols-1 row-cols-md-4 g-3 mb-4">
        <div class="col">
            <div class="stat-card">
                <div>
                    <div class="text-muted small fw-semibold">Active Listings</div>
                    <div class="fs-3 fw-bold text-dark">@Model.ActiveListingsCount</div>
                </div>
                <div class="stat-icon bg-light text-primary">
                    <i class="bi bi-house-check"></i>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div>
                    <div class="text-muted small fw-semibold">Total Bookings</div>
                    <div class="fs-3 fw-bold text-dark">@Model.TotalBookingsCount</div>
                </div>
                <div class="stat-icon bg-light text-success">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div>
                    <div class="text-muted small fw-semibold">Total Revenue</div>
                    <div class="fs-3 fw-bold text-dark">R @Model.TotalEarnings.ToString("N0")</div>
                </div>
                <div class="stat-icon bg-light text-warning">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="stat-card">
                <div>
                    <div class="text-muted small fw-semibold">Pending Action</div>
                    <div class="fs-3 fw-bold text-danger">@(Model.PendingBookings.Count + Model.PendingCheckIns.Count)</div>
                </div>
                <div class="stat-icon bg-light text-danger">
                    <i class="bi bi-bell-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Pending Booking Requests -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clock-history text-warning me-2"></i> Pending Booking Requests
                    </h5>
                    <span class="badge bg-warning text-dark rounded-pill">@Model.PendingBookings.Count pending</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.PendingBookings.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-check-circle text-success fs-1"></i>
                            <p class="mt-2 mb-0">No pending booking requests. You're all caught up!</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var booking in Model.PendingBookings)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark">@booking.Property?.Title</h6>
                                            <div class="small text-muted">
                                                Guest: <strong>@booking.Guest?.FullName</strong> (@booking.Guest?.Email)
                                            </div>
                                        </div>
                                        <span class="fw-bold text-primary">R @booking.TotalPrice.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @booking.CheckInDate.ToString("dd MMM yyyy") - @booking.CheckOutDate.ToString("dd MMM yyyy")
                                            (@booking.Nights nights)
                                        </div>
                                        <div class="d-flex gap-2">
                                            <form asp-action="ApproveBooking" asp-route-id="@booking.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                    <i class="bi bi-check-lg me-1"></i> Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectBooking" asp-route-id="@booking.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                    <i class="bi bi-x-lg me-1"></i> Reject
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Pending Check-in Document Verifications -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-vcard text-primary me-2"></i> Guest ID Check-in Verifications
                    </h5>
                    <span class="badge bg-primary rounded-pill">@Model.PendingCheckIns.Count to review</span>
                </div>
                <div class="card-body p-0">
                    @if (!Model.PendingCheckIns.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check text-muted fs-1"></i>
                            <p class="mt-2 mb-0">No guest ID verification documents awaiting review.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var checkIn in Model.PendingCheckIns)
                            {
                                <div class="list-group-item p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-1">@checkIn.Booking?.Property?.Title</h6>
                                            <div class="small text-muted">
                                                Guest: <strong>@checkIn.Booking?.Guest?.FullName</strong> •
                                                Booking #@checkIn.BookingId
                                            </div>
                                        </div>
                                        <span class="badge bg-warning text-dark">Document Uploaded</span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <div class="small text-muted">
                                            Arrival: <strong>@checkIn.Booking?.CheckInDate.ToString("dd MMM yyyy")</strong>
                                        </div>
                                        <a asp-action="VerifyCheckIn" asp-route-id="@checkIn.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="bi bi-eye me-1"></i> Review ID Document
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- My Properties Summary -->
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">My Property Listings</h5>
                    <a asp-action="Properties" class="btn btn-sm btn-outline-secondary rounded-pill">Manage All</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Listing</th>
                                    <th>Address</th>
                                    <th>Price / Night</th>
                                    <th>Status</th>
                                    <th>Check-in Guide</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Properties)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(p.PropertyImages.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/80")" class="rounded-3 object-fit-cover" style="width: 56px; height: 56px;" />
                                                <div>
                                                    <div class="fw-bold text-dark">@p.Title</div>
                                                    <div class="small text-muted">ID: #@p.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="small text-muted">@p.Address</td>
                                        <td class="fw-semibold">R @p.PricePerNight.ToString("N0")</td>
                                        <td>
                                            @if (p.IsActive)
                                            {
                                                <span class="badge bg-success rounded-pill px-2 py-1">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-pill px-2 py-1">Inactive</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="ConfigureCheckIn" asp-route-propertyId="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="bi bi-sliders me-1"></i> Rules & Steps
                                            </a>
                                        </td>
                                        <td class="text-end">
                                            <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill">
                                                    @(p.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
