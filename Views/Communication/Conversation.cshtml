@model Staybnb.ViewModels.Communication.ConversationViewModel
@using System.Security.Claims

@{
    ViewData["Title"] = $"Chat with {Model.OtherUserName}";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-3 mb-3">
                <a asp-action="Inbox" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 42px; height: 42px;">
                    @(Model.OtherUserName.FirstOrDefault())
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@Model.OtherUserName</h5>
                    <span class="small text-muted">Staybnb Direct Messages</span>
                </div>
            </div>

            <!-- Chat Container -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden d-flex flex-column" style="height: 600px;">
                <!-- Messages Box -->
                <div class="card-body p-4 overflow-auto flex-grow-1" id="chatMessages" style="background-color: #f9fafb;">
                    @if (!Model.Messages.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-chat-dots fs-1"></i>
                            <p class="mt-2">No previous messages in this thread. Say hello!</p>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var m in Model.Messages)
                            {
                                var isMe = m.SenderId == currentUserId;
                                <div class="d-flex flex-column @(isMe ? "align-items-end" : "align-items-start")">
                                    <div class="p-3 rounded-4 shadow-sm" style="max-width: 75%; @(isMe ? "background-color: #FF385C; color: #ffffff; border-bottom-right-radius: 4px;" : "background-color: #ffffff; color: #222222; border: 1px solid #ebebeb; border-bottom-left-radius: 4px;")">
                                        <div style="white-space: pre-line;">@m.Content</div>
                                    </div>
                                    <span class="text-muted small mt-1" style="font-size: 0.7rem;">@m.Timestamp.ToString("t")</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Input Footer -->
                <div class="card-footer bg-white border-top p-3">
                    <form asp-action="SendMessage" method="post" class="d-flex gap-2">
                        <input type="hidden" name="receiverId" value="@Model.OtherUserId" />
                        <input type="text" name="content" class="form-control rounded-pill px-3 py-2" placeholder="Write a message..." autocomplete="off" required />
                        <button type="submit" class="btn btn-staybnb rounded-pill px-4">
                            <i class="bi bi-send-fill me-1"></i> Send
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto scroll chat to bottom
        const chatBox = document.getElementById('chatMessages');
        if (chatBox) {
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
}
